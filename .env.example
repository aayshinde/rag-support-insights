OPENAI_API_KEY=sk-...
# Chat model used for generation. gpt-3.5-turbo works if your account still has it;
# gpt-4o-mini is cheaper and stronger.
CHAT_MODEL=gpt-4o-mini
# Model used as the evaluation judge (use a stronger model than CHAT_MODEL if you can)
JUDGE_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
